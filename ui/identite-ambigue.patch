--- /dev/null
+++ b/tests/test_identity_ambiguity.py
@@
+from agents.validation_agent import ValidationAgent
+from extraction.schema import CarteIdentiteSchema, flatten, extract_confidences
+
+
+def verified(value):
+    return {"value": value, "confidence": 0.99,
+            "source": {"page": 1, "quote": str(value)}}
+
+
+def test_ambiguous_identity_never_prefills_name(monkeypatch):
+    model = CarteIdentiteSchema(
+        nom=verified("ALAOUI"), prenom=verified("YAHYA"),
+        identite_ambigue=verified(True),
+        noms_non_attribues=verified(["ALAOUI", "YAHYA"]),
+    )
+    agent = ValidationAgent()
+    monkeypatch.setattr(agent.engine, "validate", lambda *args: {"valid": True, "results": []})
+    result = agent.run(
+        "carte_identite", flatten(model), extract_confidences(model),
+        {"suspicious": False}, sources={name: {"verified": True}
+                                      for name in model.model_fields},
+    )
+    for name in ("nom", "prenom"):
+        assert result["fields"][name]["value"] is None
+        assert result["fields"][name]["status"] == "signale"
+    assert result["needs_priority_review"] is True
+
+
+def test_unambiguous_identity_keeps_normal_validation(monkeypatch):
+    model = CarteIdentiteSchema(
+        nom=verified("ALAOUI"), prenom=verified("YAHYA"),
+        identite_ambigue=verified(False), noms_non_attribues=verified([]),
+    )
+    agent = ValidationAgent()
+    monkeypatch.setattr(agent.engine, "validate", lambda *args: {"valid": True, "results": []})
+    result = agent.run(
+        "carte_identite", flatten(model), extract_confidences(model),
+        {"suspicious": False}, sources={name: {"verified": True}
+                                      for name in model.model_fields},
+    )
+    assert result["fields"]["nom"]["value"] == "ALAOUI"
+    assert result["fields"]["prenom"]["value"] == "YAHYA"